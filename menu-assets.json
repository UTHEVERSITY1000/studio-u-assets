const categoryTags = {
  mains: "MAINS",
  starters: "STARTERS",
  desserts: "DESSERTS",
  drinks: "DRINKS",
  vectors: "VECTORS"
};

let megaDatabase = [];
const catKeys = Object.keys(vectorMap);

for (let i = 0; i < 1000; i++) {
  const catKey = catKeys[i % catKeys.length];
  const items = vectorMap[catKey];
  const itemObj = items[Math.floor(i / catKeys.length) % items.length];
  const style = styles[(i * 7) % styles.length];

  megaDatabase.push({
    title: `${style} ${itemObj.name} Vector`,
    cat: catKey,
    tag: categoryTags[catKey],
    url: `https://api.iconify.design/tabler:${itemObj.icon}`,
    type: "vector"
  });
}

// AUTO-DOWNLOAD JSON FILE
const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(megaDatabase, null, 2));
const dlAnchorElem = document.createElement('a');
dlAnchorElem.setAttribute("href", dataStr);
dlAnchorElem.setAttribute("download", "menu-assets.json");
document.body.appendChild(dlAnchorElem);
dlAnchorElem.click();
dlAnchorElem.remove();
